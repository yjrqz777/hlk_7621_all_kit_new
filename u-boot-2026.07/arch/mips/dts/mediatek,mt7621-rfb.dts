/dts-v1/;

#include "mt7621.dtsi"

/ {
	compatible = "mediatek,mt7621-rfb", "mediatek,mt7621-soc";
	model = "MediaTek MT7621 RFB (SPI-NOR)";

	aliases {
		serial0 = &uart0;
		spi0 = &spi;
	};

	chosen {
		stdout-path = &uart0;
	};

	leds { /* BOOT LED*/
		compatible = "gpio-leds";

		boot_led: led-boot {
			label = "boot";
			gpios = <&gpio0 13 1>; /* JTDO 1 = 低电平有效 */
		};
	};

	options {
		u-boot {
			compatible = "u-boot,config";
			boot-led = <&boot_led>;
			boot-led-period-ms = <250>;   /* 闪烁周期,可选 */
		};
	};
};

&pinctrl {
	state_default: pin_state {
		gpios {
			groups = "i2c", "uart3", "pcie reset";
			function = "gpio";
		};

		wdt {
			groups = "wdt";
			function = "wdt rst";
		};

		jtag {
			groups = "jtag";
			function = "gpio"; /* GPIO 模式 */
		};
	};
};

&uart0 {
	status = "okay";
};

&gpio {
	status = "okay";
};

&spi {
	status = "okay";
	num-cs = <2>;

	spi-flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		spi-max-frequency = <25000000>;
		reg = <0>;
	};
};

&eth {
	status = "okay";
};

&mmc {
	cap-sd-highspeed;

	status = "okay";
};

&ssusb {
	status = "okay";
};

&u3phy {
	status = "okay";
};
