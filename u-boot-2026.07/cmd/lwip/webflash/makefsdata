#!/bin/sh
# SPDX-License-Identifier: GPL-2.0+
#
# Generate C arrays for the standalone Web recovery assets. The CSS handling
# follows the old u-boot_mod makefsdatac flow: use YUI Compressor when a JAR is
# supplied, otherwise remove formatting whitespace.

set -eu

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
	echo "usage: $0 index.html style.css [yuicompressor.jar]" >&2
	exit 2
fi

html_file=$1
css_file=$2
yui_jar=${3:-${YUI_COMPRESSOR:-}}
asset_dir=$(dirname "$0")
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/webflash-assets.XXXXXX")

trap 'rm -f "$tmp_dir/index.html" "$tmp_dir/style.css"; rmdir "$tmp_dir"' \
	EXIT HUP INT TERM

if [ -z "$yui_jar" ]; then
	for candidate in "$asset_dir"/vendors/yuicompressor-*.jar; do
		if [ -f "$candidate" ]; then
			yui_jar=$candidate
			break
		fi
	done
fi

if [ -n "$yui_jar" ] && [ -f "$yui_jar" ] && command -v java >/dev/null 2>&1; then
	java -jar "$yui_jar" --type css --charset utf-8 "$css_file" \
		> "$tmp_dir/style.css"
else
	tr -d '\t\r\n' < "$css_file" > "$tmp_dir/style.css"
fi

# Keep the recovery page self-contained. The server deliberately accepts one
# TCP client at a time, so an early parallel stylesheet request could otherwise
# race the still-streaming HTML response.
awk -v css_file="$tmp_dir/style.css" '
	/<link rel="stylesheet" href="\/style.css">/ {
		print "<style>"
		while ((getline css < css_file) > 0)
			print css
		close(css_file)
		print "</style>"
		next
	}
	{ print }
' "$html_file" | tr -d '\t\r\n' > "$tmp_dir/index.html"

emit_array()
{
	name=$1
	file=$2

	printf 'static const char %s[] = {\n' "$name"
	od -A n -v -t x1 "$file" | awk '
	{
		for (i = 1; i <= NF; i++) {
			printf "0x%s,", $i
			if (++count % 12 == 0)
				printf "\n"
		}
	}
	END {
		if (count % 12)
			printf "\n"
	}'
	printf '0x00\n};\n\n'
}

cat <<'EOF'
/* SPDX-License-Identifier: GPL-2.0+ */
/* Auto-generated by cmd/lwip/webflash/makefsdata. Do not edit. */
#ifndef __WEBFLASH_ASSETS_H
#define __WEBFLASH_ASSETS_H

EOF

emit_array webflash_index_html "$tmp_dir/index.html"

echo '#endif /* __WEBFLASH_ASSETS_H */'
